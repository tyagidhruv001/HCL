# ── LearnAI Environment Variables ──────────────────────────────────────────

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/learnai
DB_USER=learnai
DB_PASS=learnai_pass
POSTGRES_DB=learnai
POSTGRES_USER=learnai
POSTGRES_PASSWORD=learnai_pass

# Security / JWT
JWT_SECRET=learnai-super-secret-jwt-signing-key-must-be-32-chars-minimum
JWT_EXPIRATION=86400000

# AI / LLM (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Microservices URLs
ML_URL=http://localhost:8000
VITE_API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:8765,http://localhost:8766,http://localhost:5173
