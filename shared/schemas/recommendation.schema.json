{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecommendationProfile",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "goal": { "type": "string" },
    "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "interests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timeline": { "type": "string" }
  },
  "required": ["name", "goal", "level", "interests"]
}
